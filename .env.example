# Copy to .env.local (git-ignored) and fill in from the Supabase dashboard for
# the "classpilot" project. Never commit real values.
#
# See docs/environment-setup.md for where each value lives in the dashboard.

# --- Client: safe to expose, every request is still RLS-checked ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Server only: bypasses RLS. Never bundle into the browser or an Expo build ---
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Supabase CLI: linking, migrations, type generation, pg_dump backups ---
SUPABASE_PROJECT_REF=your-project-ref
# Session-pooler URI from Settings -> Database (contains the db password):
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:5432/postgres
# Personal access token from https://supabase.com/dashboard/account/tokens :
SUPABASE_ACCESS_TOKEN=your-personal-access-token
